{
  "name": "message-bridge-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source desktop UI for a local messaging bridge.",
  "author": "Christopher Leah",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/chrisjohnleah/message-bridge-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjohnleah/message-bridge-ui.git"
  },
  "bugs": {
    "url": "https://github.com/chrisjohnleah/message-bridge-ui/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:bridge && npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:bridge && npm run build:main && vite build",
    "dist": "npm run notices && npm run build && electron-builder",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "upstream:check": "node scripts/check-upstream.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lucide-react": "^1.26.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "build": {
    "appId": "io.github.chrisjohnleah.messagebridge",
    "productName": "Message Bridge",
    "artifactName": "Message-Bridge-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSES",
        "to": "licenses"
      },
      {
        "from": "SOURCE_CODE.md",
        "to": "SOURCE_CODE.md"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "resources/icons/icon.png",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "notarize": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icons/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "resources/icons/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
